<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Só aparece quando o catálogo foi aberto para escolher a próxima
         música da playlist (ver CatalogActivity.EXTRA_QUEUE_FOR_PLAYLIST). -->
    <TextView
        android:id="@+id/tvQueueModeBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:padding="8dp"
        android:background="#1976D2"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:gravity="center"
        android:visibility="gone"
        android:text="@string/catalog_queue_mode_banner" />

    <EditText
        android:id="@+id/editSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/search_hint"
        android:inputType="text"
        android:maxLines="1"
        android:imeOptions="actionSearch"
        android:imeActionLabel="@string/search_action" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_by_label"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <RadioGroup
            android:id="@+id/radioGroupSort"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioSortCantor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/sort_by_cantor" />

            <RadioButton
                android:id="@+id/radioSortMusica"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sort_by_musica" />

        </RadioGroup>

    </LinearLayout>

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="14sp"
        android:gravity="center" />

    <!-- Só aparece quando a busca não encontra nada neste catálogo: alternativa
         para procurar um karaokê da música no YouTube (ver YouTubeSearchHelper). -->
    <Button
        android:id="@+id/btnSearchYoutubeCatalog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        style="?attr/borderlessButtonStyle" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewSongs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingEnd="28dp" />

        <!-- Trilho invisível: arrastar em qualquer ponto da faixa da direita
             pula a lista para a posição proporcional, para navegar rápido em
             catálogos com milhares de músicas. -->
        <View
            android:id="@+id/fastScrollTrack"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_gravity="end" />

        <View
            android:id="@+id/fastScrollThumb"
            android:layout_width="6dp"
            android:layout_height="48dp"
            android:layout_gravity="end|top"
            android:layout_marginEnd="8dp"
            android:background="@drawable/fast_scroll_thumb"
            android:alpha="0.85" />

        <TextView
            android:id="@+id/tvFastScrollLetter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|top"
            android:layout_marginEnd="40dp"
            android:background="@drawable/fast_scroll_bubble"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
