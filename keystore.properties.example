# Copie este arquivo para "keystore.properties" (na raiz do projeto, ao lado
# deste exemplo) e preencha com os dados reais da sua keystore de release.
# "keystore.properties" e a pasta "keystore/" nunca devem ser versionados
# (já estão no .gitignore) — sem esse arquivo, o build de release
# simplesmente sai sem assinatura, e o de debug não é afetado.

storeFile=../keystore/yamazakioke-release.jks
storePassword=troque-por-uma-senha-forte
keyAlias=yamazakioke
keyPassword=troque-por-uma-senha-forte
